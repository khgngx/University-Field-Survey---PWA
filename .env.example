# Client (Vite) — baked into the bundle at build time.
# Leave empty on Vercel (same-origin /api). MUST be an absolute URL for the
# GitHub Pages build and the Capacitor APK, where a relative /api would hit the wrong origin.
VITE_API_URL=https://<your-app>.vercel.app/api

# Server (Vercel Serverless Function only — never prefix with VITE_).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional server settings.
# Comma-separated extra origins allowed to call the API cross-origin (GitHub Pages, local dev).
# https://localhost (the Capacitor APK) is always allowed.
ALLOWED_ORIGINS=https://khgngx.github.io
# Storage bucket for photos (default: survey-photos; created by supabase/schema.sql).
SUPABASE_BUCKET=survey-photos
